<?xml version="1.0" encoding="utf-8"?>
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/amiro_hce_description"
    android:requireDeviceUnlock="false">
    <!-- The standard NFC Forum Type 4 Tag NDEF Tag Application AID
         (D2760000850101), not an app-specific value — AmiroHceService
         emulates a real Type 4 Tag so any NDEF-capable reader (this app's
         own ManagerNfcReader, or a generic NFC reader) can read it. -->
    <aid-group android:description="@string/amiro_hce_description"
        android:category="other">
        <aid-filter android:name="D2760000850101" />
    </aid-group>
</host-apdu-service>
